{
  "name": "saber",
  "productName": "Saber",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "tauri:prepare-runtime": "bun scripts/prepare-tauri-runtime.ts",
    "tauri:dev": "bun run build && bun run tauri:prepare-runtime && bun x tauri dev",
    "tauri:build": "bun run build && bun run tauri:prepare-runtime && bun x tauri build",
    "tauri:linux:build": "bun run build && bun run tauri:prepare-runtime && bun x tauri build --bundles deb,appimage",
    "test": "vitest run",
    "bench:responsiveness": "node scripts/bench-responsiveness.ts",
    "test:terminal": "bun scripts/verify-terminal.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.170.33",
    "@tanstack/react-start": "^1.168.50",
    "@tanstack/router-plugin": "^1.168.36",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.47.0",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "nitro": "3.0.260603-beta",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
