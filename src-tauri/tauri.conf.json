{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saber",
  "version": "0.1.0",
  "identifier": "pt.mstudioweb.saber",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/saber-server/.output/": "saber-server/.output/"
    }
  }
}
